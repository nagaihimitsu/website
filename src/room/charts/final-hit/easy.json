  "source": "提供キメ分析・原MIDI・原音と推定ステムの比較に基づくゲーム編曲。キメを先に保護。音高・奏法は推定であり聴音確定ではない。",
  "sourceSha256": "8502b7d6ce574ea8a38681962997bca96ec7b5c54e3c114f2d3abc54968e2aa2",
  "sections": [
    {
      "id": "K01",
      "startSec": 0,
      "endSec": 5.5,
      "title": "冒頭の刻み・短いアクセント",
      "kind": "opening_riff",
      "priority": "medium",
      "confidence": "mixed-audio candidate",
      "evidence": "0.7/0.9/1.25/2.95/3.9/4.46s 付近に低中域の明瞭なアタック。2.47–2.79sと3.55–3.85sで35–250Hzが一時的に非常に薄い",
      "arrangement": "初期リフの短い低域休止を保護し、直後の強い音を残す"
    },
    {
      "id": "K02",
      "startSec": 5.5,
      "endSec": 8.2,
      "title": "短い連打から強拍へ移る切り替え",
      "kind": "bass_drop_then_fill",
      "priority": "high-review",
      "confidence": "mixed-audio candidate",
      "evidence": "5.89–6.21sと6.83–7.28sで低域が大幅に減少。高い周波数帯のアタックは残り、7.3秒付近から低域が復帰",
      "arrangement": "ベースを無理に連打させず、休止→復帰の形を残す。間の細かい音は他楽器の可能性"
    },
    {
      "id": "K03",
      "startSec": 8.2,
      "endSec": 16,
      "title": "間を作るリフと短い応答",
      "kind": "staccato_and_space",
      "priority": "review",
      "confidence": "mixed-audio candidate",
      "evidence": "9.06/9.49/10.34/11.2/12.49/13.78/15.16s 近辺にアタック。楽器帰属は未確定",
      "arrangement": "休符を詰めずにリズムの輪郭を残す"
    },
    {
      "id": "K04",
      "startSec": 16.2,
      "endSec": 18.6,
      "title": "細かいアタックが続くフィル候補",
      "kind": "bass_drop_and_rapid_other_instrument",
      "priority": "high-review",
      "confidence": "bass/instrument ambiguous",
      "evidence": "16.17–16.92sと17.88–18.32sで35–250Hzが隣接区間に比べ非常に薄い。中高域の細かいアタックは継続",
      "arrangement": "ベースが引く瞬間を優先保存。他楽器フィルをベース譜面に大量転記しない"
    },
    {
      "id": "K05",
      "startSec": 18.7,
      "endSec": 22.7,
      "title": "低音のキメと次の反復への導入",
      "kind": "transition",
      "priority": "medium",
      "confidence": "mixed-audio candidate",
      "evidence": "20.1–20.9s低域のアタックと22.0–22.65sの短い連続アタック",
      "arrangement": "次の反復に入る直前の空白とアクセントを残す"
    },
    {
      "id": "K06",
      "startSec": 22.7,
      "endSec": 27,
      "title": "ポパ型2音キメの初期反復",
      "kind": "signature_double_hit",
      "priority": "mandatory",
      "confidence": "high rhythmic recurrence; instrument/pitch provisional",
      "evidence": "D3→E3の自動推定2音パターンが6回。間隔0.08–0.10秒。裏拍寄り",
      "arrangement": "フレーズ単位で保護。Easyは代表位置、Normal/Hardは主アクセントを残す"
    },
    {
      "id": "K07",
      "startSec": 27,
      "endSec": 30,
      "title": "細かなリズム変化・切り返し候補",
      "kind": "rhythmic_fill",
      "priority": "medium",
      "confidence": "mixed-audio candidate",
      "evidence": "27.05–29.63s付近で約0.1/0.2秒間隔の連続アタック",
      "arrangement": "重要な切り返し点を優先。すべてのアタックをノーツ化しない"
    },
    {
      "id": "K08",
      "startSec": 30.1,
      "endSec": 34,
      "title": "ポパ型キメの再登場・変奏",
      "kind": "signature_double_hit",
      "priority": "mandatory",
      "confidence": "high rhythmic recurrence; instrument/pitch provisional",
      "evidence": "30.26,30.68,31.15,31.96,32.39,33.68sのD3→E3短2音が6回検出",
      "arrangement": "音符の時刻を表拍へ丸めない。Normal/Hardは主アクセントを優先"
    },
    {
      "id": "K09",
      "startSec": 34.05,
      "endSec": 36.65,
      "title": "最も規則的なポパ連続6回",
      "kind": "signature_double_hit",
      "priority": "mandatory",
      "confidence": "high rhythmic recurrence; instrument/pitch provisional",
      "evidence": "34.11–36.25sの6回、約0.42–0.44秒ごとにD3→E3候補。後音約0.08–0.12秒遅れ。おおむね裏拍寄りの2音パターンで、2音目まで約0.1秒",
      "arrangement": "この曲の最重要保護フレーズ。Easyは毎2回に1回、Normal/Hardは全6アクセントが基準"
    },
    {
      "id": "K10",
      "startSec": 36.65,
      "endSec": 41,
      "title": "音域を下げるようなベースの切り返し候補",
      "kind": "low_register_turnaround",
      "priority": "medium",
      "confidence": "mixed-audio candidate",
      "evidence": "37.84s E1/E2同時候補、38.9–39.5s G1/G2成分、低域の複数アタック",
      "arrangement": "同時検出音をそのままオクターブ奏法と認定しない。根音移動の輪郭を残す"
    },
    {
      "id": "K11",
      "startSec": 41,
      "endSec": 46.1,
      "title": "短い繰り返しと強いフレーズ終端",
      "kind": "stabs_repeated",
      "priority": "high-review",
      "confidence": "mixed-audio candidate",
      "evidence": "41.0–41.7sにB1/B2候補、44.6–46.0sにもB1/B2成分。倍音/他楽器と未分離",
      "arrangement": "押す音数は抑え、反復のリズムとフレーズ終端を優先"
    },
    {
      "id": "K12",
      "startSec": 46.1,
      "endSec": 50.8,
      "title": "低音の間合いと強いアクセント",
      "kind": "stabs_and_space",
      "priority": "medium",
      "confidence": "mixed-audio candidate",
      "evidence": "47.93s低中域の強い立上り、48–50sには間隔のある複数のアタック",
      "arrangement": "強い一音の直前を埋めずに空ける"
    },
    {
      "id": "K13",
      "startSec": 50.8,
      "endSec": 55.9,
      "title": "ポパ型フレーズ回帰＋連続フィル",
      "kind": "signature_reprise",
      "priority": "mandatory",
      "confidence": "high rhythmic recurrence; instrument/pitch provisional",
      "evidence": "52.09,53.39,55.22sにD3→E3候補。53.5–55.97sには別種の細かな反復",
      "arrangement": "戻ってきた共通キメを残しつつ、終盤の細かい装飾は間引く"
    },
    {
      "id": "K14",
      "startSec": 55.9,
      "endSec": 60,
      "title": "終盤の細かい連打と締め候補",
      "kind": "ending_accents",
      "priority": "high-review",
      "confidence": "drum/guitar/bass ambiguous",
      "evidence": "55–57sと59.2–59.8sに約0.1秒の密集アタック。低域だけのベース奏法ではない可能性",
      "arrangement": "ドラムの連打をベースにコピーせず、ベースの最終アクセントを特定して残す"
    }
  ],
